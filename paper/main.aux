\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Accuracy vs.\ sampling ratio $r_0$ (MNIST, mean $\pm $ std over 3 noise seeds; dotted lines: ideal-randomness anchors). \textbf  {Left:} reset mode is nearly flat down to $r_0{=}0.02$; $T{=}1$ is exactly flat as predicted. \textbf  {Right:} streaming mode collapses below $r_0\approx 0.5$; larger $T$ buys roughly a decade of margin.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:e2}{{2}{4}{Accuracy vs.\ sampling ratio $\rzero $ (MNIST, mean $\pm $ std over 3 noise seeds; dotted lines: ideal-randomness anchors). \textbf {Left:} reset mode is nearly flat down to $\rzero {=}0.02$; $T{=}1$ is exactly flat as predicted. \textbf {Right:} streaming mode collapses below $\rzero \approx 0.5$; larger $T$ buys roughly a decade of margin}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Device-to-device barrier spread $\sigma _\Delta $ does not rescue streaming operation: accuracy strictly degrades with dispersion, most strongly deep in the overclocked regime (solid: streaming; dashed: reset; $T{=}32$, 5 chip seeds).}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:e3}{{3}{4}{Device-to-device barrier spread $\sigma _\Delta $ does not rescue streaming operation: accuracy strictly degrades with dispersion, most strongly deep in the overclocked regime (solid: streaming; dashed: reset; $T{=}32$, 5 chip seeds)}{figure.3}{}}
